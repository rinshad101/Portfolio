# Public URL of the deployed site (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Contact form delivery via Resend (https://resend.com). Server-side only — never prefix with NEXT_PUBLIC_.
RESEND_API_KEY=
# Inbox that receives contact form messages
CONTACT_TO_EMAIL=
# Verified sender, e.g. "Portfolio <contact@your-domain.com>"
CONTACT_FROM_EMAIL=

# Optional: GitHub token to raise the public API rate limit for the GitHub section (read-only, no scopes needed)
GITHUB_TOKEN=
